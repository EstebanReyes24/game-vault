{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/estante",
      "destination": "/app"
    },
    {
      "source": "/u/:a/vs/:b",
      "destination": "/api/pagina?tipo=comparar&a=:a&b=:b"
    },
    {
      "source": "/comparar",
      "destination": "/comparar"
    },
    {
      "source": "/noticias",
      "destination": "/"
    },
    {
      "source": "/articulos",
      "destination": "/"
    },
    {
      "source": "/u/:usuario",
      "destination": "/api/pagina?tipo=perfil&u=:usuario"
    },
    {
      "source": "/a/:id",
      "destination": "/api/pagina?tipo=articulo&id=:id"
    },
    {
      "source": "/j/:juego",
      "destination": "/api/pagina?tipo=juego&j=:juego"
    }
  ],
  "functions": {
    "api/pagina.js": {
      "includeFiles": "{app,index,juego,comparar}.html"
    },
    "api/borradores.js": {
      "includeFiles": "borradores/noticias.json"
    },
    "api/latido.js": {
      "includeFiles": "borradores/noticias.json"
    }
  },
  "crons": [
    {
      "path": "/api/latido",
      "schedule": "17 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://en.wikipedia.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://epouactrnuhdbzzvzxor.supabase.co wss://epouactrnuhdbzzvzxor.supabase.co; frame-src https://www.youtube-nocookie.com; media-src 'self' https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app",
      "destination": "/estante",
      "permanent": true
    },
    {
      "source": "/borradores/:ruta*",
      "destination": "/",
      "permanent": false
    }
  ]
}
