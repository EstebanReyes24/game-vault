{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/noticias",
      "destination": "/index.html"
    },
    {
      "source": "/articulos",
      "destination": "/index.html"
    },
    {
      "source": "/u/:usuario",
      "destination": "/api/pagina?tipo=perfil&u=:usuario"
    },
    {
      "source": "/a/:id",
      "destination": "/api/pagina?tipo=articulo&id=:id"
    }
  ],
  "functions": {
    "api/pagina.js": {
      "includeFiles": "{app,index}.html"
    }
  },
  "crons": [
    {
      "path": "/api/latido",
      "schedule": "23 13 * * 1,4"
    }
  ]
}
